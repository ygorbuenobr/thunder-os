# CANDIDATE ONLY: fill with verified identifiers, numeric IDs, and a private
# credential FILE PATH. Never put the credential value in this file.
# Invalid zeros and missing identifiers intentionally prevent startup.
THUNDER_LI_BROKER_COMPANY=
THUNDER_LI_BROKER_ACCOUNT=
THUNDER_LI_BROKER_PUBLIC_ID=
THUNDER_LI_BROKER_PANEL_UID=0
THUNDER_LI_BROKER_SOCKET_GID=0
THUNDER_LI_BROKER_SOCKET=/run/thunder-li-reader/account.sock
THUNDER_LI_BROKER_CREDENTIAL_FILE=/etc/thunder-os/connectsafely-read-broker.key
