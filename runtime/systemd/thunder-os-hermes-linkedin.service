[Unit]
Description=Thunder OS deterministic Hermes LinkedIn cadence (one bounded run)
After=network-online.target

[Service]
Type=oneshot
# Same identity and database as painel-thunder and thunder-os-agent (root,
# painel.db under the ygor-personal Hermes profile). Effects stay off here;
# a live activation overrides this in a reviewed drop-in, never in this file.
User=root
Group=root
Environment=PYTHONPATH=/opt/thunder-os/current/_ferramentas
Environment=THUNDER_EXTERNAL_EFFECTS_ENABLED=false
ExecStart=/usr/bin/python3 -m thunder_os.hermes_linkedin_runtime --config /etc/thunder-os/hermes-linkedin-cadence.json --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.hermes/profiles/ygor-personal/painel-dados
